# Android / Gradle build artifacts
build/
.gradle/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# APK outputs
*.apk
*.aab
*.ap_
*.dex

# Native build
*.o
*.so
*.a

# Models — NEVER commit
*.gguf
*.ggml
*.safetensors
*.bin
app/src/main/assets/models/

# macOS / editor
.DS_Store
*.swp
*~

# Secrets
keystore.properties
*.jks
*.keystore
# Vendored third-party headers/stubs.
# Default: ignore so each dev pulls fresh; whitelist the ones the build
# genuinely needs cloneable (OpenCL deps, since we generate the stub
# rather than vendor a binary).
app/src/main/cpp/third_party/*
!app/src/main/cpp/third_party/OpenCL-Headers/
!app/src/main/cpp/third_party/opencl-stub/

# Kotlin compiler caches / transient build artifacts
.kotlin/
default.profraw
scripts/__pycache__/
